# Copy to tesla.local.properties (gitignored) and fill in from developer.tesla.com
# NEVER commit tesla.local.properties or secrets/

tesla.app.id=c0ece73a-3df9-46ba-b994-373dd6cf4515

# OAuth (Third-party token)
tesla.client.id=
tesla.client.secret=
# Must exactly match Tesla Developer Portal → Allowed Redirect URI(s).
# HTTPS bridge page deep-links back to myt://auth/callback
tesla.oauth.redirect.uri=https://yskwon-wayforyou.github.io/myt/oauth/callback

# Partner registration domain (must match public key hosting)
tesla.partner.domain=

# Fleet API region — start with NA; switch if 421 Incorrect region
tesla.fleet.api.base=https://fleet-api.prd.na.vn.cloud.tesla.com
tesla.auth.url=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3

# Vehicle Command signing (keep private key local)
tesla.private.key.path=secrets/tesla/private-key.pem

# Phase 1: your Model 3 VIN (after first OAuth vehicle list)
tesla.vehicle.vin=

# Optional: in-app GitHub Issues on crash (leave token empty to use agent + gh)
github.issues.enabled=true
github.issues.repo=yskwon-wayforyou/MyT
github.issues.token=
